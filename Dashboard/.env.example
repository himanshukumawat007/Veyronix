# =====================================================================
# BHU-DRISHTI — environment configuration (copy to .env, never commit .env)
# =====================================================================

# ---- Server ----------------------------------------------------------
PORT=3000
# Secret used to sign prototype login sessions. Set a long random value.
SESSION_SECRET=

# Prototype role logins (change these!). Defaults: authority / authority@123, operator / operator@123
AUTHORITY_USERNAME=
AUTHORITY_PASSWORD=
OPERATOR_USERNAME=
OPERATOR_PASSWORD=

# "public" = anyone can use the demo scenario controls (good for presentations)
# "staff"  = demo controls require an authority/operator login
DEMO_CONTROLS=public

# ---- AI ---------------------------------------------------------------
# Optional. Used ONLY on the server for plain-language situation summaries.
# Never put this key in frontend code or VITE_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional. Real risk-forecast model endpoint (e.g. the LSTM service). When unset, the
# platform uses a clearly-labelled simulated trend baseline.
AI_PREDICT_URL=
# Optional. Existing Gemini narrative endpoint (/api/ai-risk) used by the classic console.
GEMINI_API_KEY=

# ---- Database (optional PostgreSQL; in-memory buffer is used when unset) --
DATABASE_URL=
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=

# ---- Grafana (internal technical monitoring) ------------------------------
# URL the API server uses for health checks
GRAFANA_URL=
# URL the browser should open (defaults to GRAFANA_URL, or http://localhost:3001)
GRAFANA_PUBLIC_URL=
GRAFANA_API_KEY=
GRAFANA_ORG_ID=1
GRAFANA_DATASOURCE_UID=postgres

# ---- Frontend (Vite — these ARE exposed to the browser: no secrets here) ---
# Base URL of the platform API. Defaults to same-origin /api/v1
VITE_API_BASE_URL=
# Map tiles (defaults to OpenStreetMap, darkened). Use your own tile server in production.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
# Dashboard polling interval in ms (default 4000)
VITE_POLL_INTERVAL_MS=
